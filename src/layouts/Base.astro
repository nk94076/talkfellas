---
import '../styles/global.css';
import { SITE } from '../site';
const { title, description = SITE.tagline } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{fullTitle}</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><meta property="og:type" content="website" />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
<link rel="icon" href="/favicon.svg" />
</head>
<body>
<header class="site"><div class="wrap wide">
  <a class="logo" href="/">Talk<span>Fellas</span></a>
  <nav><a href="/">Home</a><a href="/blog/">Blog</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav>
</div></header>
<main><slot /></main>
<footer class="site"><div class="wrap wide">
  <p>© {new Date().getFullYear()} {SITE.name}. As an affiliate, we may earn from qualifying purchases.</p>
  <a href="/about/">About</a><a href="/affiliate-disclosure/">Affiliate Disclosure</a><a href="/privacy-policy/">Privacy Policy</a><a href="/contact/">Contact</a>
</div></footer>
</body></html>
